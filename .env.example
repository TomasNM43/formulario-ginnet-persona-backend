DB_USER=
DB_PASSWORD=
DB_DSN=
DB_SCHEMA=GINNET_AUDIO
DB_POOL_MIN=2
DB_POOL_MAX=10
AUDIO_ROOT=D:\audios
MAX_UPLOAD_MB=200
ALLOWED_EXTENSIONS=wav,mp3,flac
CORS_ORIGINS=http://localhost:5173
LOG_DIR=C:\apps\audios\logs
STUCK_JOB_MINUTES=15
TRANSCRIPTION_ENGINE=faster-whisper
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PRELOAD_WHISPER=true
PHRASE_THRESHOLD=1.0
PHRASE_LANGUAGE=es-ES
# Obligatorio en la API (>= 32 caracteres aleatorios). Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAX_FILE_SIZE_MB=10
VOICE_ALLOWED_EXTENSIONS=wav,mp3,flac,m4a,ogg,webm,mp4
TEMP_DIR=C:\apps\audios\tmp_voice
