<?xml version="1.0" encoding="utf-8"?>
<!--
  Aplicación IIS "/api" (carpeta física = esta carpeta backend).
  AJUSTAR: rutas de processPath y ENV_FILE. El .env va FUERA de la carpeta del sitio.
  maxAllowedContentLength = 2 archivos * MAX_UPLOAD_MB + 1 MB de overhead, en bytes
  (200 MB -> 2*200*1048576 + 1048576 = 420478976). Recalcular si cambia MAX_UPLOAD_MB.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\apps\audios\backend\.venv\Scripts\python.exe"
                  arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --workers 4"
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  requestTimeout="00:20:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="C:\apps\audios\logs\httpplatform-stdout">
      <environmentVariables>
        <environmentVariable name="ENV_FILE" value="C:\apps\audios\config\.env" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
      </environmentVariables>
    </httpPlatform>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="420478976" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
